# systemd-native run mode (SPEC §10.4 A).
#
#   sudo cp deploy/libresesh.service /etc/systemd/system/
#   sudo cp deploy/libresesh.env.example /etc/libresesh.env   # then edit it
#   sudo systemctl enable --now libresesh
#
[Unit]
Description=LibreSesh — (un)conference scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=libresesh
Group=libresesh
WorkingDirectory=/srv/libresesh
EnvironmentFile=/etc/libresesh.env
ExecStart=/usr/bin/node server/dist/index.js
Restart=always
RestartSec=3

# The SQLite file and its -wal/-shm sidecars live here.
ReadWritePaths=/srv/libresesh/data

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
