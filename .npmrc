# Supply-chain hardening for npm projects built on this boilerplate.
# Rationale + other ecosystems (pnpm/yarn/cargo/go/pip): .devcontainer/STACKS.md
# §Supply-chain hardening. Delete this file if it fights your workflow.

# Don't execute packages' install/postinstall scripts — the main code-execution
# vector in npm supply-chain attacks. Packages needing a native build step
# (sharp, esbuild, …) then fail or no-op at install; build just those
# explicitly: npm rebuild <pkg> --ignore-scripts=false
# Caveat: also skips YOUR package.json pre/post hooks (e.g. prebuild) —
# `npm run <x>`, start, and test themselves still run.
ignore-scripts=true

# Pin exact versions on `npm install <pkg>` (no ^ ranges): new releases only
# enter via a deliberate update, where a review/cooldown can apply.
save-exact=true
